# VupsRouter Environment Configuration

# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SESSION_SECRET=vupsrouter_dev_session_secret_replace_in_production_32bytes_minimum!
LOG_LEVEL=info

# Database (Default: SQLite for instant local development, swappable to PostgreSQL)
# For SQLite: file:./dev.db
# For PostgreSQL: postgresql://username:password@localhost:5432/vupsrouter?schema=public
DATABASE_URL="file:./dev.db"

# AI Provider Credentials
FLAGSHIPROUTER_BASE_URL=http://localhost:20128/v1
FLAGSHIPROUTER_API_KEY=

# OpenRouter (Hosts verified free models: deepseek-r1:free, llama-3.3-70b-instruct:free, etc.)
OPENROUTER_API_KEY=

# Hugging Face Inference API
HUGGINGFACE_API_KEY=

# Google AI Gemini API
GOOGLE_AI_API_KEY=

# Ollama Local AI (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Metadata Caching
MODEL_CACHE_TTL_SECONDS=300

# Email Delivery (Optional for password recovery)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=noreply@vupsrouter.ai
